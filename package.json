{
  "name": "ghost-protocol",
  "version": "1.0.0",
  "description": "Ghost: Confidential Prize-Savings Protocol powered by Zama FHE",
  "main": "index.js",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "postinstall": "npm install --prefix apps/web",
    "build": "npm run build --prefix apps/web",
    "keeper": "npx ts-node scripts/keeper-bot.ts",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:privacy": "hardhat test test/PrivacyIntegrity.test.ts",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia"
  },
  "keywords": [
    "fhe",
    "zama",
    "fhevm",
    "confidential-finance",
    "prize-savings",
    "pooltogether",
    "solidity",
    "sepolia"
  ],
  "author": "Ghost Protocol Team",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.7",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.17",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.11",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.9",
    "@openzeppelin/contracts": "^5.0.2",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.16",
    "@types/mocha": "^10.0.7",
    "@types/node": "^20.14.9",
    "chai": "^4.3.10",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.1",
    "hardhat": "^2.22.6",
    "hardhat-gas-reporter": "^1.0.10",
    "solidity-coverage": "^0.8.12",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.5.2"
  }
}
